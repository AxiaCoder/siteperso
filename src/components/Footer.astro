---
const year = new Date().getFullYear();
---

<footer class="py-6 border-t border-terminal-cyan/20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <p class="text-center text-terminal-text text-xs">
      <span class="text-terminal-green">©</span> {year} <span class="text-terminal-text-dim mx-2">|</span> Built with <span class="text-terminal-amber">Astro</span> & <span class="text-terminal-cyan">Claude</span> <span class="text-terminal-text-dim mx-2">|</span> <span class="text-terminal-cyan">&lt;/&gt;</span>
    </p>
  </div>
</footer>
