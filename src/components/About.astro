---
const lines = [
  "Fullstack developer with nearly 10 years of experience, strongest on the backend.",
  "Specialized in API design and robust architectures.",
  "",
  "Philosophy: clean code, simplicity, maintainable solutions.",
  "Stack: Node.js (AdonisJS, NestJS) & PHP (Symfony, Laravel).",
  "",
  "Looking for: modern stack, well-crafted projects — remote or Lyon.",
];
---

<section id="about" class="py-24">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <div class="mb-6 text-terminal-text text-sm">
      <span class="text-terminal-green">$</span> <span class="text-terminal-amber">cat</span> ./about.md
    </div>

    <div class="border border-terminal-cyan/30 p-6 bg-terminal-bg-light">
      <div class="text-terminal-text text-xs mb-4 flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-terminal-green"></span>
        <span class="w-3 h-3 rounded-full bg-terminal-amber"></span>
        <span class="w-3 h-3 rounded-full bg-terminal-cyan"></span>
        <span class="ml-2 text-terminal-text-dim">about.md</span>
      </div>

      <div class="space-y-1">
        {lines.map((line, i) => (
          <p class={`${line === '' ? 'h-4' : ''} ${line.startsWith('Philosophy') || line.startsWith('Looking') || line.startsWith('Stack') ? 'text-terminal-green' : 'text-terminal-text'}`}>
            {line && (
              <>
                <span class="text-terminal-cyan select-none w-8 inline-block text-right mr-4">{i + 1}</span>
                {line}
              </>
            )}
          </p>
        ))}
      </div>
    </div>
  </div>
</section>
