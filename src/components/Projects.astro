---
// Pitch = bénéfice utilisateur, pas la techno. `note` = LE choix technique notable.
const projects = [
  {
    name: 'MyLittleLibrary',
    description: 'Keep track of every film, series and anime you watch — progress, ratings and favourites in one place.',
    note: 'A shared UI package — design tokens and Storybook — feeds the Adonis app, and CI gates every push on lint, types and a security audit.',
    stack: ['AdonisJS 6', 'Inertia', 'React 19', 'PostgreSQL', 'Storybook', 'Playwright'],
    status: 'beta',
    link: 'https://www.mylittlelibrary.io/',
  },
  {
    name: 'MyLittleTrivia',
    description: 'Quiz nights with friends — write your own questions and play them in French or English.',
    note: 'Categories, questions and answers each own a translations table, so adding a language means inserting rows, not migrating the schema.',
    stack: ['AdonisJS 6', 'Inertia', 'React 19', 'PostgreSQL', 'Japa', 'Playwright'],
    status: 'alpha',
    link: null,
  },
];
---

<section id="projects" class="py-24">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <div class="mb-6 text-terminal-text text-sm">
      <span class="text-terminal-green">$</span> <span class="text-terminal-amber">ls</span> -la ./projects
    </div>

    <div class="border border-terminal-cyan/30 bg-terminal-bg-light overflow-hidden">
      <!-- Projects as file listing -->
      <div class="divide-y divide-terminal-cyan/10">
        {projects.map((project) => (
          <div class="block p-4">
            <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
              <div class="flex items-center gap-2">
                <span class={project.link ? 'text-terminal-green' : 'text-terminal-text-dim'}>
                  {project.link ? 'drwxr-xr-x' : 'drwx------'}
                </span>
                {project.link ? (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-terminal-cyan hover:text-terminal-amber transition-colors hover:underline"
                  >
                    {project.name}/ <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span class="text-terminal-cyan">{project.name}/</span>
                )}
              </div>
              <div class="flex items-center gap-2">
                {project.link ? (
                  <span class="text-xs px-2 py-0.5 border border-terminal-green/60 text-terminal-green">
                    live
                  </span>
                ) : (
                  <span
                    class="text-xs px-2 py-0.5 border border-terminal-text-dim/40 text-terminal-text-dim"
                    title="Source not public — happy to walk through it on request"
                  >
                    private
                  </span>
                )}
                <span class="text-xs px-2 py-0.5 border border-terminal-amber/60 text-terminal-amber">
                  {project.status}
                </span>
              </div>
            </div>

            <p class="text-terminal-text text-sm mb-1 pl-4">
              <span class="text-terminal-text-dim">#</span> {project.description}
            </p>

            <p class="text-terminal-text-dim text-sm mb-3 pl-4">
              <span class="text-terminal-green">$</span> {project.note}
            </p>

            <div class="flex flex-wrap gap-2 pl-4">
              {project.stack.map((tech) => (
                <span class="text-xs text-terminal-amber">
                  [{tech}]
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
