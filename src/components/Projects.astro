---
const projects = [
  {
    name: 'MyLittleLibrary',
    description: 'Unified media library for managing different media types in one place.',
    stack: ['AdonisJS', 'Inertia', 'React', 'PostgreSQL', 'pnpm'],
    status: 'alpha',
    link: null,
  },
  {
    name: 'MyLittleTrivia',
    description: 'Multiplayer quiz game in party mode. Create questions and challenge friends. Multilingual (fr/en).',
    stack: ['AdonisJS', 'Inertia', 'React', 'PostgreSQL', 'pnpm'],
    status: 'alpha',
    link: null,
  },
];
---

<section id="projects" class="py-24">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <div class="mb-6 text-terminal-text text-sm">
      <span class="text-terminal-green">$</span> <span class="text-terminal-amber">ls</span> -la ./projects
    </div>

    <div class="border border-terminal-cyan/30 bg-terminal-bg-light overflow-hidden">
      <!-- Projects as file listing -->
      <div class="divide-y divide-terminal-cyan/10">
        {projects.map((project) => (
          <div class="block p-4">
            <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
              <div class="flex items-center gap-2">
                <span class={project.link ? 'text-terminal-green' : 'text-terminal-text-dim'}>
                  {project.link ? 'drwxr-xr-x' : 'drwx------'}
                </span>
                {project.link ? (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-terminal-cyan hover:text-terminal-amber transition-colors hover:underline"
                  >
                    {project.name}/
                  </a>
                ) : (
                  <span class="text-terminal-cyan">{project.name}/</span>
                )}
              </div>
              <div class="flex items-center gap-2">
                {!project.link && (
                  <span
                    class="text-xs px-2 py-0.5 border border-terminal-text-dim/40 text-terminal-text-dim"
                    title="Source not public — happy to walk through it on request"
                  >
                    private
                  </span>
                )}
                <span class="text-xs px-2 py-0.5 border border-terminal-amber/60 text-terminal-amber">
                  {project.status}
                </span>
              </div>
            </div>

            <p class="text-terminal-text text-sm mb-3 pl-4">
              <span class="text-terminal-text-dim">#</span> {project.description}
            </p>

            <div class="flex flex-wrap gap-2 pl-4">
              {project.stack.map((tech) => (
                <span class="text-xs text-terminal-amber">
                  [{tech}]
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
