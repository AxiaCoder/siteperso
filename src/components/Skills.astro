---
const skills = [
  { category: 'backend', items: ['Node.js', 'AdonisJS', 'NestJS', 'TypeScript', 'PHP', 'Symfony', 'Laravel'] },
  { category: 'database', items: ['PostgreSQL', 'MySQL', 'Drizzle', 'Lucid ORM'] },
  { category: 'api', items: ['REST', 'OpenAPI', 'Swagger'] },
  { category: 'frontend', items: ['React', 'Inertia.js', 'Tailwind'] },
  { category: 'infra', items: ['Docker', 'CI/CD', 'Linux'] },
  { category: 'tools', items: ['Git', 'pnpm', 'Monorepo', 'Testing', 'Jira', 'Linear'] },
  { category: 'payments', items: ['Payline', 'Adyen'] },
];

// Aligne la colonne des items comme un vrai `tree`
const labelWidth = Math.max(...skills.map((s) => s.category.length)) + 1;
---

<section id="skills" class="py-24 bg-terminal-bg-light">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <div class="mb-6 text-terminal-text text-sm">
      <span class="text-terminal-green">$</span> <span class="text-terminal-amber">tree</span> ./skills
    </div>

    <div class="border border-terminal-cyan/30 p-6 bg-terminal-bg overflow-x-auto">
      <pre class="text-sm leading-relaxed"><code class="text-terminal-text"><span class="text-terminal-cyan">skills/</span>
{skills.map((skill, i) => (
  <Fragment>
<span class="text-terminal-text-dim">{i === skills.length - 1 ? '└── ' : '├── '}</span><span class="text-terminal-green">{`${skill.category}/`.padEnd(labelWidth + 1)}</span>  <span class="text-terminal-amber">{skill.items.join(', ')}</span>
</Fragment>
))}</code></pre>
    </div>
  </div>
</section>
