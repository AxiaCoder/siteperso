---
const experiences = [
  {
    company: 'VoyagePrive',
    position: 'Backend Developer',
    period: '2025-2026',
    tasks: [
      'Catalog management system',
      'Mobile API development',
      'Checkout tunnel implementation',
    ],
  },
  {
    company: 'Winzana',
    position: 'Backend Developer',
    period: '2021-2025',
    tasks: [
      'Contractor at VoyagePrive: catalog, mobile API, checkout (2 years)',
      'Contest & rewards platform for food industry client (NestJS/React)',
      'Travel tools maintenance and refactoring (PHP, Java, React)',
    ],
  },
  {
    company: 'Tooeasy',
    position: 'Web Developer',
    period: '2016-2021',
    tasks: [
      'Websites with Codeigniter & WordPress',
      'Hybrid mobile apps with Cordova',
      'WordPress trainer',
    ],
  },
];
---

<section id="experience" class="py-24 bg-terminal-bg-light">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <div class="mb-6 text-terminal-text text-sm">
      <span class="text-terminal-green">$</span> <span class="text-terminal-amber">git log</span> --graph ./career
    </div>

    <div class="border border-terminal-amber/30 p-6 bg-terminal-bg text-sm leading-relaxed">
      {experiences.map((exp, i) => (
        <Fragment>
          <div class="flex gap-3">
            <span class="w-2 shrink-0 text-terminal-amber select-none" aria-hidden="true">*</span>
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="text-terminal-cyan font-semibold">{exp.period}</span>
              <span class="text-terminal-amber">{exp.position}</span>
              <span class="text-terminal-text">@ {exp.company}</span>
            </div>
          </div>

          <div class={`flex gap-3 ${i < experiences.length - 1 ? 'pb-5' : ''}`}>
            <span class="w-2 shrink-0 flex justify-center" aria-hidden="true">
              <span class="w-px bg-terminal-amber/40"></span>
            </span>
            <ul class="pl-4 space-y-1">
              {exp.tasks.map((task) => (
                <li class="text-terminal-text">{task}</li>
              ))}
            </ul>
          </div>
        </Fragment>
      ))}
    </div>
  </div>
</section>
