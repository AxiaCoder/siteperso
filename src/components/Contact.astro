---
const email = 'benoit.guelin.pro@gmail.com';
const mailto = `mailto:${email}?subject=${encodeURIComponent('Contact via benoit-guelin.fr')}`;

const links = [
  { cmd: 'mail', value: email, href: mailto },
  { cmd: 'open', value: 'linkedin.com/in/benoît-guelin', href: 'https://www.linkedin.com/in/beno%C3%AEt-guelin-51947a10b/' },
  { cmd: 'open', value: 'github.com/AxiaCoder', href: 'https://github.com/AxiaCoder' },
];
---

<section id="contact" class="py-24">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <div class="mb-6 text-terminal-text text-sm">
      <span class="text-terminal-green">$</span> <span class="text-terminal-cyan">./contact.sh</span>
    </div>

    <div class="border border-terminal-green/30 p-6 bg-terminal-bg-light">
      <p class="text-terminal-text mb-6">
        <span class="text-terminal-cyan">&gt;</span> Interested? Let's talk.
      </p>

      <div class="space-y-3">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('mailto') ? undefined : '_blank'}
            rel={link.href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
            class="block text-terminal-text hover:text-terminal-cyan transition-colors group"
          >
            <span class="text-terminal-green">$</span> <span class="text-terminal-amber">{link.cmd}</span> <span class="group-hover:underline">{link.value}</span>
          </a>
        ))}
      </div>

      <div class="mt-8 pt-6 border-t border-terminal-green/20">
        <p class="text-terminal-text text-sm">
          <span class="text-terminal-green">$</span> <span class="text-terminal-amber">echo</span> <span class="text-terminal-cyan">"No forms, no tracking. Just code."</span>
        </p>
        <p class="text-terminal-green text-sm mt-1">
          No forms, no tracking. Just code.<span class="animate-blink">_</span>
        </p>
      </div>
    </div>
  </div>
</section>
