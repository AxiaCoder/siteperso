---
// Police self-hébergée : pas de requête vers Google (RGPD), pas de tiers bloquant le rendu.
// Seules les graisses réellement utilisées sont chargées : 400 (corps) et 600 (font-semibold).
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-600.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Fullstack Developer - Node.js & PHP" } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Benoît Guelin" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Benoît Guelin" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Benoît Guelin — Fullstack Developer" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-terminal-bg text-terminal-text font-mono antialiased relative overflow-x-hidden">
    <!-- Scanline effect -->
    <div class="pointer-events-none fixed inset-0 z-50 opacity-[0.03]" aria-hidden="true">
      <div class="absolute inset-0 bg-[repeating-linear-gradient(0deg,transparent,transparent_2px,rgba(0,0,0,0.3)_2px,rgba(0,0,0,0.3)_4px)]"></div>
    </div>

    <!-- CRT vignette effect -->
    <div class="pointer-events-none fixed inset-0 z-40 bg-[radial-gradient(ellipse_at_center,transparent_0%,rgba(0,0,0,0.4)_100%)]" aria-hidden="true"></div>

    <slot />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  ::selection {
    background-color: rgba(245, 158, 11, 0.4);
    color: #0a0a08;
  }

  /* Amber glow on links */
  a {
    transition: text-shadow 0.2s ease;
  }

  a:hover {
    text-shadow: 0 0 8px rgba(245, 158, 11, 0.6);
  }

  /* Scrollbar styling */
  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: #0a0a08;
  }

  ::-webkit-scrollbar-thumb {
    background: #d97706;
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #f59e0b;
  }
</style>
